  <!-- The package content is the staged installation prefixes, so this project
       only drives nuget pack through the nuspec; it compiles nothing. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NuspecFile>$(MSBuildThisFileDirectory)eportskf.nuspec</NuspecFile>
    <NuspecBasePath>$(EportskfStage)</NuspecBasePath>
    <NuspecProperties>version=$(EportskfVersion);repositoryUrl=$(RepositoryUrl);repositoryCommit=$(RepositoryCommit)</NuspecProperties>
    <NoWarn>NU5100;NU5128</NoWarn>
  </PropertyGroup>
</Project>
